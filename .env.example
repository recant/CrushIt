# Maritime hosts the persistent OpenClaw agent.
# Create a key with provision, deploy, and manage scopes:
# maritime keys create --name goal-governor-dev --scopes manage --json
MARITIME_API_KEY=mk_replace_me

# Free Gemini API key from Google AI Studio.
# The backend installs it into each Maritime agent as an encrypted secret.
GEMINI_API_KEY=

# Pinned OpenClaw model. Gemini 2.5 Flash has a free API tier.
GOAL_GOVERNOR_MODEL=google/gemini-2.5-flash

# Inkbox is now an app-level transport, not a per-Maritime-agent plugin.
# Use the verified agent-scoped key and mailbox created by Inkbox signup.
INKBOX_API_KEY=
INKBOX_EMAIL_ADDRESS=
INKBOX_API_BASE_URL=https://inkbox.ai/api/v1

# Optional SMS. This is the Inkbox phone-number UUID, not the E.164 number.
# The recipient must text START to the Inkbox number before outbound SMS works.
INKBOX_PHONE_NUMBER_ID=

PORT=3000
APP_BASE_URL=http://localhost:3000
APP_WEBHOOK_SECRET=change-me

# Development behavior
DEMO_MODE=true
MARITIME_AGENT_READY_TIMEOUT_MS=180000
MORNING_POLL_SECONDS=30
DEADLINE_POLL_SECONDS=30

# Optional Twilio fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Resend fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=Goal Governor <onboarding@resend.dev>
