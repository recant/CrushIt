# Required for real Maritime planning. Create with:
# maritime keys create --name goal-governor-dev --json
MARITIME_API_KEY=mk_replace_me

PORT=3000
APP_BASE_URL=http://localhost:3000
APP_WEBHOOK_SECRET=change-me

# Development behavior
DEMO_MODE=true
MORNING_POLL_SECONDS=30
DEADLINE_POLL_SECONDS=30

# Delivery options. The dashboard lets each user choose maritime, sms, email, or console.
# Maritime delivery asks the user's OpenClaw agent to use its paired WhatsApp/Telegram channel.

# Optional direct SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional direct email fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=Goal Governor <onboarding@resend.dev>
