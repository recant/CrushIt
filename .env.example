# Maritime hosts the persistent OpenClaw Identity agent.
# Create a key with provision, deploy, and manage scopes:
# maritime keys create --name goal-governor-dev --json
MARITIME_API_KEY=mk_replace_me

# Free Gemini API key from Google AI Studio.
# The backend installs it into each Maritime agent as an encrypted secret.
GEMINI_API_KEY=

# Pinned OpenClaw model. Gemini 2.5 Flash has a free API tier.
GOAL_GOVERNOR_MODEL=google/gemini-2.5-flash

PORT=3000
APP_BASE_URL=http://localhost:3000
APP_WEBHOOK_SECRET=change-me

# Development behavior
DEMO_MODE=true
MARITIME_AGENT_READY_TIMEOUT_MS=180000
MORNING_POLL_SECONDS=30
DEADLINE_POLL_SECONDS=30

# Optional direct SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional direct email fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=Goal Governor <onboarding@resend.dev>
